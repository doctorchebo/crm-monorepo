{
  "name": "@whatsapp-crm/media-compression-lambda",
  "version": "1.0.0",
  "private": true,
  "description": "Lambda function for media compression using ffmpeg",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --external:@aws-sdk/*",
    "build:watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.450.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.131",
    "@types/node": "^20.10.0",
    "esbuild": "^0.19.0",
    "typescript": "~5.3.3"
  }
}
